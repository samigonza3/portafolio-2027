# Copia este archivo a .env para probar en local (npm run dev). En Netlify se cargan en Site configuration > Environment variables.

# Token de API de ChateaPro (perfil > API Keys). Sin esto la bandeja corre en modo demostracion.
CHATEAPRO_TOKEN=

# Clave para entrar a la bandeja. Obligatoria cuando hay token real.
APP_PASSWORD=

# Opcionales
# CHATEAPRO_BASE_URL=https://chateapro.app/api
# TZ_OFFSET_HOURS=-5
# UPSTREAM_TZ_OFFSET_HOURS=0
